# Copy this file to `.env` and fill in real values before running the service.
# Keep secrets out of source control.

# Claude / Anthropic-compatible provider
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.claudy.cloud
CLAUDE_MODEL=claude-sonnet-4.6

# Groq / OpenAI-compatible client
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Optional: override service port
SERVICE_PORT=8000
